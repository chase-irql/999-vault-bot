# 999 Vault Discord bot configuration.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required ---

# Bot token from the Discord Developer Portal -> Bot -> Reset Token.
# Never commit this, never paste it into an issue, never log it.
DISCORD_TOKEN=MTA0000000000000000.XXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional (defaults shown) ---

# Application ID from the Developer Portal -> General Information.
# Nothing at runtime reads this; it is only needed to build the invite URL.
# A malformed value is still rejected rather than ignored.
DISCORD_CLIENT_ID=1040000000000000000

# Prefix for the only command surface. Matching is case-insensitive.
COMMAND_PREFIX=jw!

# Archive API root. No trailing slash.
API_BASE_URL=https://juicewrldapi.com/juicewrld

# Comma-separated guild IDs. When non-empty the bot leaves any guild not listed.
# Leave empty to allow every guild that invites it.
GUILD_ALLOWLIST=

# Comma-separated text channel IDs. When non-empty, commands are only accepted
# in these channels; empty means every channel the bot can see.
# This is convenience, not enforcement — Discord's own channel permission
# overwrites, and Server Settings -> Integrations -> Command Permissions for
# slash commands, stop the event reaching the bot at all.
CHANNEL_ALLOWLIST=

# debug | info | warn | error | silent
LOG_LEVEL=info

# Absolute path to a system FFmpeg binary. When empty, ffmpeg-static is used.
FFMPEG_PATH=

# Leave voice after this many milliseconds alone in a channel.
IDLE_DISCONNECT_MS=300000

# Archive request timeout and retry budget.
API_TIMEOUT_MS=30000
API_RETRIES=4

# Starting volume for a new guild player, 0-200.
DEFAULT_VOLUME=100

# Station poll interval while any guild is in radio mode.
RADIO_POLL_MS=15000

# --- Voice smoke test only (npm run verify:voice) ---
TEST_GUILD_ID=
TEST_VOICE_CHANNEL_ID=
TEST_GUILD_ID_2=
TEST_VOICE_CHANNEL_ID_2=
